{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AtaCanYmc/bom-sourcing/schemas/bom-output.schema.json",
  "title": "BOM Sourcing Output",
  "description": "Structured BOM item array emitted by the bom-sourcing agent skill.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "raw_name",
      "canonical_name",
      "quantity",
      "status",
      "source_files",
      "constraints",
      "search_queries",
      "match_confidence",
      "stock_status",
      "notes"
    ],
    "properties": {
      "raw_name": { "type": "string", "minLength": 1 },
      "canonical_name": { "type": "string", "minLength": 1 },
      "quantity": { "type": ["integer", "null"], "minimum": 1 },
      "status": {
        "type": "string",
        "enum": ["confirmed", "inferred_required", "optional_or_assumed"]
      },
      "source_files": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "constraints": { "type": "object" },
      "search_queries": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "match_confidence": {
        "type": "string",
        "enum": ["exact", "partial", "ambiguous", "unmatched"]
      },
      "stock_status": {
        "type": "string",
        "enum": ["in_stock", "low_stock", "out_of_stock", "unknown"]
      },
      "notes": { "type": "string" }
    }
  }
}
